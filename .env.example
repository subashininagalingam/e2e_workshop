# Copy this file to ".env" and fill it in. Never share or upload the real .env file.

# Local testing: DEBUG=True. On a live server: DEBUG=False
DEBUG=True
# Any long random text (50+ characters). Required when DEBUG=False.
SECRET_KEY=change-me-to-a-long-random-text
ALLOWED_HOSTS=*
# Needed when DEBUG=False and you use HTTPS, e.g. https://yourname.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Public address of the site (no trailing slash). Used in QR codes and emails.
SITE_URL=http://127.0.0.1:8000
# Where students are sent after the thank-you page
POST_SUBMIT_REDIRECT_URL=https://errors2experts.com/

# Email (Gmail needs an App Password, not your normal password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
MAIL_FROM_NAME=Errors2Experts
# Where "new registration" alerts go
ADMIN_NOTIFY_EMAIL=

# Institute details shown on the site
ORG_NAME=Errors2Experts IT Training & IT Services
ORG_SHORT_NAME=Errors2Experts
ORG_WEBSITE=https://errors2experts.com/
ORG_EMAIL=errors2experts.official@gmail.com
ORG_PHONE=9363342646
# All assistance numbers shown in the footer (comma separated)
ORG_PHONES=9363342646,9043341503,8015306807
ORG_ADDRESS=Dindigul, Tamil Nadu
ORG_REGISTRATION=MSME Registered (UDYAM-TN-06-0108008)
# Social links (leave blank to hide)
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=
SOCIAL_WHATSAPP=
